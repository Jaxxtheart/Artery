# Local Development Environment Variables
# Copy this file to .env.local and fill in your values

# Frontend - API URL for local development
# Points to local dev server (server.js)
VITE_API_URL=http://localhost:3001

# Supabase Database (Required for Phase 4)
# Get these from https://supabase.com project settings
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Resend Email Service (Required for Phase 4)
# Get this from https://resend.com
RESEND_API_KEY=re_your_api_key_here
ADMIN_EMAIL=invest@arterycapital.com
FROM_EMAIL=Artery Capital <noreply@arterycapital.com>

# Admin Dashboard (Required for Admin Access)
ADMIN_PASSWORD=admin123

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:5173

# Development Notes:
# 1. Copy this file: cp .env.local.example .env.local
# 2. Fill in your actual values
# 3. Run both: npm run dev (frontend) and npm run server (backend)
# 4. Or use: npm run dev:full (runs both concurrently)
