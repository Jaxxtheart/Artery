# Local Development Environment Variables
# Copy this file to .env.local and fill in your values
# cp .env.local.example .env.local

# Frontend - API URL for local development
VITE_API_URL=http://localhost:3001
VITE_CRON_SECRET=your_cron_secret_same_as_below

# Supabase Database
# Get from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Coinbase Advanced Trade API
# Get from: https://www.coinbase.com/settings/api
COINBASE_API_KEY=your_coinbase_api_key
COINBASE_API_SECRET=your_coinbase_api_secret

# Alpaca Stock Trading API (paper trading)
# Get free paper keys from: https://app.alpaca.markets (Paper Trading section)
ALPACA_API_KEY=your_alpaca_paper_key
ALPACA_API_SECRET=your_alpaca_paper_secret
# Set to 'false' ONLY when switching to live stock trading
ALPACA_PAPER=true

# Resend Email Service
# Get from: https://resend.com
RESEND_API_KEY=re_your_api_key_here
ADMIN_EMAIL=jaxxtheart@gmail.com

# Admin & Cron Security
ADMIN_PASSWORD=your_secure_admin_password
CRON_SECRET=your_random_32_char_cron_secret_here

# Trading Configuration
INITIAL_CAPITAL=1441
TARGET_PROFIT=1000

# Development Notes:
# 1. Copy: cp .env.local.example .env.local
# 2. Fill in your API keys
# 3. Run schema.sql in Supabase SQL editor
# 4. Start: npm run dev:full
# 5. Dashboard: http://localhost:5173/trading
