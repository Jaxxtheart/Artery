{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "_comment": "Org design token seed. Mirrors DESIGN_SYSTEM.md §2-4. Framework-agnostic — map into Tailwind theme, CSS custom properties, Style Dictionary, etc. per project. 'accent' and any per-project overrides live in the consuming project, not here.",
  "version": "0.1.0",
  "source": "https://github.com/Jaxxtheart/Artery/blob/main/DESIGN_SYSTEM.md",

  "typography": {
    "families": {
      "ui": {
        "value": "\"PP Neue Montreal\", \"Helvetica Neue\", Inter, -apple-system, sans-serif",
        "role": "Body copy, UI, forms, nav, tables"
      },
      "display": {
        "value": "\"PP Editorial New\", Georgia, serif",
        "role": "Editorial headlines, pull quotes, marketing hero copy"
      },
      "expressive": {
        "value": "\"PP Right Grotesk\", \"PP Neue Machina\", \"PP Neue Montreal\", sans-serif",
        "role": "Bold/condensed/wide brand headlines, wordmarks"
      },
      "mono": {
        "value": "\"PP Fraktion Mono\", \"PP Right Grotesk Mono\", ui-monospace, \"SFMono-Regular\", monospace",
        "role": "Data, tickers, timestamps, code"
      }
    },
    "scale": {
      "unit": "px",
      "base": 16,
      "steps": [12, 14, 16, 18, 21, 24, 32, 40, 56, 72, 96]
    },
    "lineHeight": {
      "body": 1.5,
      "heading": 1.1
    },
    "tracking": {
      "headingLarge": "-0.02em",
      "body": "0em"
    }
  },

  "color": {
    "_comment": "Neutral scale is fixed; 'accent' and 'semantic' hex values are placeholders — each project sets its own accent and tunes semantic tones to sit quietly beside it.",
    "neutral": {
      "ink950": "#0A0A0A",
      "ink800": "#262626",
      "ink500": "#737373",
      "ink300": "#D4D4D4",
      "ink100": "#F5F5F5",
      "paper0": "#FFFFFF"
    },
    "accent": {
      "500": "#REPLACE_PER_PROJECT"
    },
    "semantic": {
      "success": "#1F9D55",
      "danger": "#DC2626",
      "warning": "#D97706"
    }
  },

  "spacing": {
    "unit": "px",
    "scale": [4, 8, 12, 16, 24, 32, 48, 64, 96, 128]
  },

  "layout": {
    "grid": {
      "desktopColumns": 12,
      "mobileColumns": 4,
      "gutter": { "min": 24, "max": 32 },
      "contentMaxWidth": 1280
    }
  },

  "motion": {
    "easing": {
      "entrance": "cubic-bezier(0.16, 1, 0.3, 1)",
      "state": "ease-in-out"
    },
    "duration": {
      "microMs": [120, 180],
      "transitionMs": [250, 400],
      "maxDecorativeMs": 600
    }
  }
}
