# Frontend Environment Variables

# For local development
VITE_API_URL=http://localhost:3001

# For Vercel production - API routes will be at the same domain
# Leave empty or set to empty string to use relative URLs
# VITE_API_URL=

# Phase 4: Backend Integration Environment Variables

# Supabase Database (Required for Phase 4)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Resend Email Service (Required for Phase 4)
RESEND_API_KEY=re_your_resend_api_key_here
ADMIN_EMAIL=invest@arterycapital.com
FROM_EMAIL=Artery Capital <noreply@arterycapital.com>

# Application Configuration
NEXT_PUBLIC_APP_URL=https://arterycapital.com

# Admin Dashboard (Required for Admin Access)
ADMIN_PASSWORD=admin123
